<?xml version="1.0" encoding="utf-8"?>
<!--
  Khai báo các thư mục mà FileProvider được phép cấp quyền truy cập tạm thời
  (content:// Uri) cho ứng dụng khác, dùng khi chia sẻ / lưu file WAV trên
  Android 9 trở xuống (API <= 28). Bắt buộc phải có file này khớp với
  <provider> khai báo trong AndroidManifest.xml, nếu không FileProvider.getUriForFile()
  sẽ crash với lỗi "Failed to find configured root".
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Environment.getExternalStoragePublicDirectory(DIRECTORY_MUSIC)/DocDocTTS -->
    <external-path name="public_music_docdoctts" path="Music/DocDocTTS/" />
    <!-- Phòng trường hợp cần chia sẻ file tạm trong cache -->
    <cache-path name="tts_cache" path="." />
</paths>
